{:paths []
 :deps {app/shared {:local/root "packages/shared"}}
 :aliases
 {:api {:extra-deps {app/api {:local/root "apps/api"}}}
  :shared {:extra-deps {app/shared {:local/root "packages/shared"}}}
  :api-sdk {:extra-deps {app/api-sdk {:local/root "packages/api-sdk"}}}
  :app {:extra-deps {app/app {:local/root "packages/app"}}}
  :outdated {:replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
             :main-opts ["-m" "antq.core"]}
  :kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
          :main-opts ["-m" "clj-kondo.main"]}
  :cljfmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
           :main-opts ["-m" "cljfmt.main"]}}}
