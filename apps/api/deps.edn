{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        app/shared {:local/root "../../packages/shared"}
        metosin/reitit {:mvn/version "0.7.2"}
        metosin/muuntaja {:mvn/version "0.6.10"}
        ring/ring-core {:mvn/version "1.13.0"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        integrant/integrant {:mvn/version "0.11.0"}
        org.mongodb/mongodb-driver-sync {:mvn/version "5.2.0"}
        buddy/buddy-sign {:mvn/version "3.6.1-359"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        com.taoensso/timbre {:mvn/version "6.6.0"}
        aero/aero {:mvn/version "1.1.6"}}
 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {integrant/repl {:mvn/version "0.3.3"}
                     org.clojure/tools.namespace {:mvn/version "1.5.0"}
                     nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}}}
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}
  :build {:extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
