FROM clojure:temurin-25-tools-deps-trixie

COPY --from=node:24-trixie-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:24-trixie-slim /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/apps/mobile

COPY apps/mobile/deps.edn /workspace/apps/mobile/deps.edn
COPY packages/shared/deps.edn /workspace/packages/shared/deps.edn
COPY packages/api-sdk/deps.edn /workspace/packages/api-sdk/deps.edn
COPY packages/app/deps.edn /workspace/packages/app/deps.edn
RUN mkdir -p /workspace/packages/shared/src /workspace/packages/api-sdk/src /workspace/packages/app/src \
  && clojure -A:mobile -P

COPY apps/mobile/package.json /workspace/apps/mobile/package.json
RUN npm install

COPY packages /workspace/packages
COPY apps/mobile /workspace/apps/mobile

EXPOSE 8081 9632 19000

CMD ["sh", "-c", "rm -f /tmp/deps-ready && npm install --no-audit --no-fund && touch /tmp/deps-ready && exec npx shadow-cljs watch app"]
