{:deps {:aliases [:web]}

 :nrepl {:port 9630}
 :http {:port 9631 :host "0.0.0.0"}

 :dev-http {8280 {:root "public"
                  :push-state/index "index.html"
                  :push-state/headers {"content-type" "text/html; charset=utf-8"}}}

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn app.web.core/init}}
   :devtools {:preloads [day8.re-frame-10x.preload]}
   :dev {:compiler-options {:closure-defines
                            {app.web.core/api-base-url #shadow/env ["API_BASE_URL" :default "http://localhost:8080"]
                             re-frame.trace.trace-enabled? true}}}
   :release {:compiler-options {:optimizations :advanced
                                :closure-defines
                                {app.web.core/api-base-url #shadow/env ["API_BASE_URL" :default "/"]}}}}}}
